# ==============================================
# 1. APPLICATION & SECURITY
# ==============================================
SECRET_KEY=django-insecure-production-ready-change-in-production-embassy-bot-secret-key-2025
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend,botalmavia-production.up.railway.app
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,https://botalmavia-production.up.railway.app

# ==============================================
# 2. DATABASE (PostgreSQL)
# ==============================================
POSTGRES_DB=visa_bot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_here
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres_secure_password_here@postgres:5432/visa_bot
DB_SSL_REQUIRE=False

# ==============================================
# 3. MESSAGE BROKER & CACHE (Redis / Celery)
# ==============================================
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0

# ==============================================
# 4. BROWSER AUTOMATION (Selenium / Chrome)
# ==============================================
SELENIUM_HEADLESS=true
CHROME_BIN=/usr/bin/chromium
CHROMEDRIVER_PATH=/usr/bin/chromedriver
BOT_SIMULATION_MODE=false

# ==============================================
# 5. PORTS & EXTERNAL ACCESS
# ==============================================
HTTP_PORT=80
BACKEND_PORT=8000
